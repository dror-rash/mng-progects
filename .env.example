# Copy to .env (git-ignored). Loaded by Next.js apps and by `pnpm db:*`.

# Where the shell proxies /example/* to
EXAMPLE_ZONE_URL=http://localhost:3001
DASHBOARD_ZONE_URL=http://localhost:3002

# Local Postgres (docker compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
BETTER_AUTH_URL=http://localhost:3000

# Files (task 057): the bucket, and locally the fake-gcs-server from docker compose (`pnpm db:up`). Leave
# STORAGE_LOCAL_URL out to use Google Cloud Storage itself (deployed: the Cloud Run service account).
STORAGE_BUCKET=app-files
STORAGE_LOCAL_URL=http://localhost:4443
