{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "CLOUD_SQL_CONNECTION_NAME",
    "DB_USER",
    "DB_PASSWORD",
    "DB_NAME",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "ALLOW_PREVIEW_ORIGINS",
    "EXAMPLE_ZONE_URL",
    "DASHBOARD_ZONE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["EXAMPLE_ZONE_URL", "DASHBOARD_ZONE_URL"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": {}
  }
}
